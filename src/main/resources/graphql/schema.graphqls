# =========================================================================
# GraphQL Schema definition for vietapibt2 (Spring Boot 3 + GraphQL)
# Chức năng: Category & Product CRUD, Phân trang, Lọc Category & Sắp xếp giá
# =========================================================================

type Category {
    categoryId: ID!
    categoryName: String!
    icon: String
    products: [Product]
}

type Product {
    productId: ID!
    productName: String!
    quantity: Int!
    unitPrice: Float!
    images: String
    description: String!
    discount: Float
    createDate: String
    status: Int
    category: Category
}

# DTO trả về kết quả phân trang cho Category
type CategoryPage {
    content: [Category]!
    totalPages: Int!
    totalElements: Int!
    pageNumber: Int!
    pageSize: Int!
    first: Boolean!
    last: Boolean!
}

# DTO trả về kết quả phân trang cho Product
type ProductPage {
    content: [Product]!
    totalPages: Int!
    totalElements: Int!
    pageNumber: Int!
    pageSize: Int!
    first: Boolean!
    last: Boolean!
}

# Input cho Thêm mới & Cập nhật Category
input CategoryInput {
    categoryName: String!
    icon: String
}

# Input cho Thêm mới & Cập nhật Product
input ProductInput {
    productName: String!
    quantity: Int!
    unitPrice: Float!
    images: String
    description: String!
    discount: Float
    status: Int
    categoryId: ID!
}

# Định nghĩa các Query (Truy vấn)
type Query {
    # 1. Trang Home: Hiển thị tất cả product có price từ thấp đến cao
    productsSortedByPriceAsc: [Product]!

    # 2. Trang Home: Lấy tất cả product của 01 category
    productsByCategory(categoryId: ID!): [Product]!

    # 3. Lấy tất cả danh mục (cho dropdown filter / select)
    allCategories: [Category]!

    # 4. Chi tiết theo ID
    categoryById(id: ID!): Category
    productById(id: ID!): Product

    # 5. Phân trang & tìm kiếm Category
    categoriesPaged(page: Int = 0, size: Int = 5, keyword: String = ""): CategoryPage!

    # 6. Phân trang & tìm kiếm Product
    productsPaged(page: Int = 0, size: Int = 6, keyword: String = "", categoryId: ID): ProductPage!
}

# Định nghĩa các Mutation (Thao tác Thêm / Sửa / Xóa)
type Mutation {
    # CRUD Category
    createCategory(input: CategoryInput!): Category!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!

    # CRUD Product
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
}
